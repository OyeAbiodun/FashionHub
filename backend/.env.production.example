APP_NAME=FashionOS
APP_ENV=production
DEBUG=false
API_PREFIX=/api/v1
FRONTEND_URL=https://app.example.com
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
JWT_SECRET_KEY=replace-with-a-secret-manager-value-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-transactional-email-provider-key
EMAIL_FROM_ADDRESS=no-reply@yourfashionosdomain.example
EMAIL_FROM_NAME=FashionOS
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_RATE_LIMIT_COUNT=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_IP_RATE_LIMIT_COUNT=10
