APP_NAME=FashionOS
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql+asyncpg://fashionos_user:replace-with-local-password@localhost:5432/fashionos_test
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
EMAIL_PROVIDER=capture
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@fashionos.example
EMAIL_FROM_NAME=FashionOS
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_RATE_LIMIT_COUNT=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_IP_RATE_LIMIT_COUNT=10
